<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Lyra</RootNamespace>
    <AssemblyName>Lyra</AssemblyName>
    <ApplicationManifest>..\Shared\app.manifest</ApplicationManifest>
    <Product>Lyra</Product>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WFAC010 is the WinForms "use SetHighDpiMode" hint; these are WPF apps, which take DPI awareness from the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Only applies to self-contained single-file publishes (as in the README); roughly halves the exe. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <ProjectReference Include="..\Lyrics\Lyrics.csproj" />
  </ItemGroup>
</Project>
