<Window x:Class="Lyra.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lyra"
        Title="Lyra Settings" Width="680" Height="760" MinHeight="520" MinWidth="600"
        ResizeMode="CanResize"
        Style="{DynamicResource DarkWindow}">
    <Window.Resources>
        <!-- A wallpaper-like backdrop for the previews, so colours and shadow read as they would over a desktop. -->
        <LinearGradientBrush x:Key="PreviewBackdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF20304A" Offset="0" />
            <GradientStop Color="#FF4A2A55" Offset="0.55" />
            <GradientStop Color="#FF7A4A3A" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>
    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Lyra" Style="{StaticResource TitleText}" />
            <TextBlock x:Name="HeaderStatus" Style="{StaticResource SubtleText}" Margin="0,4,0,0" Text="Word-by-word lyrics over your screen" />
        </StackPanel>

        <TabControl x:Name="Tabs">
            <!-- STYLE -->
            <TabItem Header="Style">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border CornerRadius="12" Height="250" Background="{StaticResource PreviewBackdrop}" ClipToBounds="True"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <local:LyricsCanvas x:Name="StylePreview" Margin="0,10" />
                                <TextBlock Text="PREVIEW" FontSize="10" FontWeight="SemiBold" Foreground="#80FFFFFF"
                                           Margin="12,8" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <TextBlock Text="STYLE" Style="{StaticResource SectionText}" />
                        <UniformGrid x:Name="StyleCards" Columns="2" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- APPEARANCE -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border CornerRadius="12" Height="150" Background="{StaticResource PreviewBackdrop}" ClipToBounds="True"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <local:LyricsCanvas x:Name="AppearancePreview" Margin="0,6" />
                        </Border>

                        <TextBlock Text="TEXT" Style="{StaticResource SectionText}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock Text="Font" Style="{StaticResource LabelText}" />
                                    <Border Style="{StaticResource SegmentHost}">
                                        <StackPanel x:Name="FontSegments" Orientation="Horizontal" />
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}" />
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Size" Style="{StaticResource LabelText}" />
                                    <Slider x:Name="SizeSlider" Grid.Column="1" Minimum="0.6" Maximum="2.0" SmallChange="0.05" LargeChange="0.1" ValueChanged="OnSizeChanged" />
                                    <TextBlock x:Name="SizeLabel" Grid.Column="2" Style="{StaticResource LabelText}" HorizontalAlignment="Right" />
                                </Grid>
                                <Border Style="{StaticResource RowDivider}" />
                                <Grid Style="{StaticResource Row}">
                                    <CheckBox x:Name="ShadowBox" Content="Shadow for legibility over any wallpaper" Click="OnToggle" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="COLOURS" Style="{StaticResource SectionText}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock Text="Text (sung)" Style="{StaticResource LabelText}" />
                                    <ContentControl x:Name="TextColorHost" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Highlight (current word)" Style="{StaticResource LabelText}" />
                                        <Button x:Name="AccentButton" Content="Use accent" Margin="12,0,0,0" Padding="10,3" FontSize="12" Click="OnUseAccent" />
                                    </StackPanel>
                                    <ContentControl x:Name="HighlightHost" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock Text="Dim (upcoming)" Style="{StaticResource LabelText}" />
                                    <ContentControl x:Name="DimColorHost" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Border Style="{StaticResource RowDivider}" />
                                <Grid Style="{StaticResource Row}">
                                    <CheckBox x:Name="AlbumBox" Content="Match album art (highlight follows the artwork)" Click="OnToggle" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- DISPLAY -->
            <TabItem Header="Display">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PLACEMENT" Style="{StaticResource SectionText}" Margin="4,0,0,8" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock Text="Position on screen" Style="{StaticResource LabelText}" />
                                    <Border Style="{StaticResource SegmentHost}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="PlaceBottom" Content="Bottom" GroupName="Place" Style="{StaticResource Segment}" Click="OnToggle" />
                                            <RadioButton x:Name="PlaceCentre" Content="Centre" GroupName="Place" Style="{StaticResource Segment}" Click="OnToggle" />
                                            <RadioButton x:Name="PlaceTop" Content="Top" GroupName="Place" Style="{StaticResource Segment}" Click="OnToggle" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}" />
                                <Grid Style="{StaticResource Row}">
                                    <CheckBox x:Name="ShowBox" Content="Show lyrics" Click="OnToggle" />
                                </Grid>
                                <Border Style="{StaticResource RowDivider}" />
                                <Grid Style="{StaticResource Row}">
                                    <CheckBox x:Name="AwakeBox" Content="Keep screen awake while music plays" Click="OnToggle" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="DISPLAYS" Style="{StaticResource SectionText}" />
                        <Border Style="{StaticResource Card}" Padding="16,10">
                            <StackPanel x:Name="DisplayList" />
                        </Border>

                        <TextBlock Text="TIMING" Style="{StaticResource SectionText}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Lyrics latency" Style="{StaticResource LabelText}" />
                                    <Slider x:Name="LatencySlider" Grid.Column="1" Minimum="-1" Maximum="1.5" SmallChange="0.05" LargeChange="0.25" ValueChanged="OnLatencyChanged" />
                                    <TextBlock x:Name="LatencyLabel" Grid.Column="2" Style="{StaticResource LabelText}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="Added to every song. Positive values light words slightly early, which reads as on time."
                                           Style="{StaticResource SubtleText}" Margin="0,-4,0,10" />
                                <Border Style="{StaticResource RowDivider}" />
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock x:Name="OffsetLabel" Text="This song: +0.00 s" Style="{StaticResource LabelText}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Earlier" Click="OnEarlier" Margin="0,0,8,0" />
                                        <Button Content="Later" Click="OnLater" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- STATUS -->
            <TabItem Header="Status">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PLAYERS" Style="{StaticResource SectionText}" Margin="4,0,0,8" />
                        <StackPanel x:Name="PlayerList" />
                        <TextBlock Text="LYRICS" Style="{StaticResource SectionText}" />
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <StackPanel x:Name="LyricsStatusPanel" />
                        </Border>
                        <TextBlock Style="{StaticResource SubtleText}" Margin="4,14,4,0"
                                   Text="Lyra reads any app in the Windows media flyout (Spotify, Apple Music, browsers…). Lyrics come from lrclib.net." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
