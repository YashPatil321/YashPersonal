<Window x:Class="Halo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Halo"
        Title="Halo Settings" Width="560" Height="780" MinHeight="480"
        ResizeMode="CanResize"
        Style="{DynamicResource DarkWindow}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">
            <!-- Header with a live preview of the glow -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Halo" Style="{StaticResource TitleText}" />
                    <TextBlock x:Name="StatusText" Text="A soft light around your screen" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Width="200" Height="118" CornerRadius="10" Background="#FF0E0E11"
                        BorderBrush="#22FFFFFF" BorderThickness="1" ClipToBounds="True">
                    <Grid x:Name="PreviewHost" ClipToBounds="True">
                        <local:GlowSurface x:Name="PreviewGlow" />
                        <local:GlowSurface x:Name="PreviewRing" />
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Text="GENERAL" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <CheckBox x:Name="EnabledBox" Content="Show the glow" Click="OnChanged" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Mode" Style="{StaticResource LabelText}" />
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ModeMusic" Content="Music Sync" GroupName="Mode" Style="{StaticResource Segment}" Click="OnChanged" />
                                <RadioButton x:Name="ModeBreathe" Content="Breathe" GroupName="Mode" Style="{StaticResource Segment}" Click="OnChanged" />
                                <RadioButton x:Name="ModeStatic" Content="Static" GroupName="Mode" Style="{StaticResource Segment}" Click="OnChanged" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource Row}">
                        <CheckBox x:Name="LoginBox" Content="Launch at login" Click="OnChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="COLOURS" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <CheckBox x:Name="AlbumBox" Content="Match album art" Click="OnChanged" />
                    </Grid>
                    <TextBlock Text="Uses the most vibrant colours of the artwork. Falls back to the colours below when there is no artwork."
                               Style="{StaticResource SubtleText}" Margin="0,-6,70,10" />
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Primary" Style="{StaticResource LabelText}" />
                        <ContentControl x:Name="PrimaryHost" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Secondary" Style="{StaticResource LabelText}" />
                        <ContentControl x:Name="SecondaryHost" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="TertiaryBox" Content="Tertiary" Click="OnChanged" HorizontalAlignment="Left" ToolTip="Use a third colour" />
                        <ContentControl x:Name="TertiaryHost" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Split" Style="{StaticResource LabelText}" />
                        <Slider x:Name="SplitSlider" Grid.Column="1" Minimum="0.1" Maximum="0.9" SmallChange="0.05" LargeChange="0.1" ValueChanged="OnSliderChanged" />
                        <TextBlock x:Name="SplitLabel" Grid.Column="2" Style="{StaticResource LabelText}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="SHAPE" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Thickness" Style="{StaticResource LabelText}" />
                        <Slider x:Name="ThicknessSlider" Grid.Column="1" Minimum="2" Maximum="60" SmallChange="1" LargeChange="5" ValueChanged="OnSliderChanged" />
                        <TextBlock x:Name="ThicknessLabel" Grid.Column="2" Style="{StaticResource LabelText}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Glow" Style="{StaticResource LabelText}" />
                        <Slider x:Name="GlowSlider" Grid.Column="1" Minimum="0" Maximum="80" SmallChange="1" LargeChange="8" ValueChanged="OnSliderChanged" />
                        <TextBlock x:Name="GlowLabel" Grid.Column="2" Style="{StaticResource LabelText}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="DISPLAYS" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}" Padding="16,10">
                <StackPanel x:Name="DisplayList" />
            </Border>

            <TextBlock x:Name="AudioStatus" Style="{StaticResource SubtleText}" Margin="4,16,4,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
